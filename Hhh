-- file: rbx_universal.lua · runtime: Luau (هر اکسکیوتور: Delta، Arceus X، Fluxus، Wave، Electron)
-- INF-JUMP + ESP + NOCLIP — مستقل از بازی، موبایل و PC
-- دکمه‌ها: INF (پرش بی‌نهایت) · ESP (باکس/نیم/فاصله) · NC (نوکلکیپ)

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS        = game:GetService("UserInputService")
local Workspace  = game:GetService("Workspace")
local CoreGui    = game:GetService("CoreGui")
local Camera     = Workspace.CurrentCamera
local LP         = Players.LocalPlayer

local cfg = {
    inf_jump  = false,
    esp       = true,
    noclip    = false,
    team_check= true,
    wall_check= true,
    tracer    = false,
    esp_color = Color3.fromRGB(0, 255, 170),
}

-- //////////////////////////////////////////////////////////// GUI

local gui = Instance.new("ScreenGui")
gui.Name = "universal_cheat"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
pcall(function() gui.Parent = CoreGui end) or (gui.Parent = LP:WaitForChild("PlayerGui"))

local overlay = Instance.new("Frame")
overlay.Size = UDim2.fromScale(1, 1)
overlay.BackgroundTransparency = 1
overlay.Parent = gui

local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(150, 44)
panel.Position = UDim2.new(0, 12, 0, 90)
panel.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
panel.BackgroundTransparency = 0.15
panel.BorderSizePixel = 0
panel.Active = true
panel.Draggable = true
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 8)

local layout = Instance.new("UIListLayout")
layout.FillDirection = Enum.FillDirection.Horizontal
layout.Padding = UDim.new(0, 4)
layout.Parent = panel

local pad = Instance.new("UIPadding")
pad.PaddingLeft = UDim.new(0, 6); pad.PaddingTop = UDim.new(0, 6)
pad.Parent = panel

local function mkbtn(text, w)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(w or 40, 32)
    b.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.TextSize = 14
    b.Font = Enum.Font.GothamBold
    b.BorderSizePixel = 0
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.Parent = panel
    return b
end

local function paint(b, on)
    b.BackgroundColor3 = on and Color3.fromRGB(0, 190, 120) or Color3.fromRGB(40, 40, 48)
end

local bInf = mkbtn("INF", 40)
local bEsp = mkbtn("ESP", 40)
local bNc  = mkbtn("NC",  40)
paint(bInf, cfg.inf_jump); paint(bEsp, cfg.esp); paint(bNc, cfg.noclip)

bInf.MouseButton1Click:Connect(function() cfg.inf_jump = not cfg.inf_jump; paint(bInf, cfg.inf_jump) end)
bEsp.MouseButton1Click:Connect(function() cfg.esp = not cfg.esp; paint(bEsp, cfg.esp) end)
bNc.MouseButton1Click:Connect(function()  cfg.noclip  = not cfg.noclip;  paint(bNc, cfg.noclip) end)

-- //////////////////////////////////////////////////////////// INFINITE JUMP
-- هر بار که بازیکن دکمه پرش را می‌زند — روی موبایل هم همان JumpRequest است —
-- اگر humanoid در حال سقوط باشد، به‌زور به حالت Jumping می‌رود.

UIS.JumpRequest:Connect(function()
    if not cfg.inf_jump then return end
    local ch = LP.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- //////////////////////////////////////////////////////////// NOCLIP
-- هر فریم روی هر BasePart کاراکتر CanCollide = false.

local function noclip_tick()
    if not cfg.noclip then return end
    local ch = LP.Character; if not ch then return end
    for _, part in ipairs(ch:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
    end
end

-- //////////////////////////////////////////////////////////// ESP (ScreenGui frames)

local boxes = {}

local function ensure(p)
    if boxes[p] then return end
    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 2
    box.BorderColor3 = cfg.esp_color
    box.Visible = false
    box.Parent = overlay

    local name = Instance.new("TextLabel")
    name.BackgroundTransparency = 1
    name.TextColor3 = cfg.esp_color
    name.Font = Enum.Font.GothamBold
    name.TextSize = 12
    name.TextStrokeTransparency = 0.3
    name.Size = UDim2.fromOffset(220, 16)
    name.AnchorPoint = Vector2.new(0.5, 1)
    name.Parent = overlay

    local hpbg = Instance.new("Frame")
    hpbg.BackgroundColor3 = Color3.new(0, 0, 0)
    hpbg.BorderSizePixel = 0
    hpbg.Parent = overlay

    local hp = Instance.new("Frame")
    hp.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
    hp.BorderSizePixel = 0
    hp.Parent = hpbg

    local tracer = Instance.new("Frame")
    tracer.AnchorPoint = Vector2.new(0.5, 0)
    tracer.BorderSizePixel = 0
    tracer.BackgroundColor3 = cfg.esp_color
    tracer.Visible = false
    tracer.Parent = overlay

    local dist = Instance.new("TextLabel")
    dist.BackgroundTransparency = 1
    dist.TextColor3 = cfg.esp_color
    dist.Font = Enum.Font.Gotham
    dist.TextSize = 11
    dist.TextStrokeTransparency = 0.4
    dist.Size = UDim2.fromOffset(80, 14)
    dist.AnchorPoint = Vector2.new(0.5, 0)
    dist.Parent = overlay

    boxes[p] = { box=box, name=name, hpbg=hpbg, hp=hp, dist=dist, tracer=tracer }
end

local function hide(p)
    local b = boxes[p]; if not b then return end
    for _, v in pairs(b) do v.Visible = false end
end

local function humanoid(ch)
    local h = ch:FindFirstChildOfClass("Humanoid")
    if h and h.Health > 0 then return h end
end

local function is_teammate(p)
    if not cfg.team_check then return false end
    local ok, same = pcall(function() return LP.Team ~= nil and LP.Team == p.Team end)
    return ok and same
end

local function visible(part)
    if not cfg.wall_check then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character }
    local hit = Workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, params)
    return hit == nil or hit.Instance:IsDescendantOf(part.Parent)
end

local function w2s(pos)
    local v, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), on and v.Z > 0
end

local function draw_esp()
    local vs = Camera.ViewportSize
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then hide(p); continue end
        local ch = p.Character
        local hum = ch and humanoid(ch)
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        local head = ch and ch:FindFirstChild("Head")
        if not (hum and hrp and head) or is_teammate(p) then hide(p); continue end
        ensure(p)
        local top, on1    = w2s(head.Position + Vector3.new(0, 0.7, 0))
        local bottom, on2 = w2s(hrp.Position - Vector3.new(0, 2.8, 0))
        if not (on1 and on2) then hide(p); continue end
        local h = math.abs(bottom.Y - top.Y)
        local w = h * 0.5
        local sx, sy = top.X - w / 2, top.Y
        local d = (head.Position - Camera.CFrame.Position).Magnitude
        local B = boxes[p]

        B.box.Visible = cfg.esp
        B.box.Position = UDim2.fromOffset(sx, sy)
        B.box.Size = UDim2.fromOffset(w, h)

        B.name.Visible = cfg.esp
        B.name.Text = string.format("%s [%d]", p.Name, math.floor(hum.Health))
        B.name.Position = UDim2.fromOffset(top.X, sy - 2)

        local frac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        B.hpbg.Visible = cfg.esp
        B.hpbg.Position = UDim2.fromOffset(sx - 5, sy)
        B.hpbg.Size = UDim2.fromOffset(3, h)
        B.hp.Visible = cfg.esp
        B.hp.Position = UDim2.fromOffset(0, h * (1 - frac))
        B.hp.Size = UDim2.fromOffset(3, h * frac)

        B.dist.Visible = cfg.esp
        B.dist.Text = string.format("%dm", math.floor(d))
        B.dist.Position = UDim2.fromOffset(top.X, sy + h + 2)

        B.tracer.Visible = cfg.esp and cfg.tracer
        if cfg.tracer then
            local from = Vector2.new(vs.X / 2, vs.Y)
            local dir  = top - from
            local len  = dir.Magnitude
            B.tracer.Position = UDim2.fromOffset(from.X, from.Y)
            B.tracer.Size = UDim2.fromOffset(1, len)
            B.tracer.Rotation = math.deg(math.atan2(dir.Y, dir.X)) - 90
        end
    end
end

-- //////////////////////////////////////////////////////////// LOOP

RunService.RenderStepped:Connect(function()
    draw_esp()
    noclip_tick()
end)

print("[universal_cheat] loaded — INF · ESP · NC")
